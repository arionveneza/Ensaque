# Valores falsos, só para src/lib/supabase.ts não travar ao carregar em
# teste (Cadastros.test.tsx importa o módulo real via vi.importActual).
# Nenhum teste faz chamada de rede de verdade — tudo que toca o Supabase é
# mockado. Comitado de propósito: sem isto o CI (que não tem .env.local)
# quebra a suite inteira por causa de um único arquivo de teste.
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=chave-fake-para-teste
