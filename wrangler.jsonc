{
  // Publicação na Cloudflare (Workers com assets estáticos).
  //
  // Existe como alternativa ao GitHub Pages, adotada em 06/08/2026 durante um
  // incidente crítico de Actions/Pages que segurou a publicação por horas.
  // A Cloudflare clona o repositório e constrói na infraestrutura dela, sem
  // passar pelo GitHub Actions — por isso funciona mesmo com o Pages fora.
  //
  // O site aqui fica na RAIZ do domínio, então BASE_PATH não deve ser
  // definido no build da Cloudflare (o vite.config cai em '/' sozinho).
  // No GitHub Pages continua valendo BASE_PATH=/Ensaque/, porque lá é um
  // "project site" servido em subpasta.
  "name": "ensaque",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./dist",
    // o app é uma SPA: endereço desconhecido devolve o index em vez de 404,
    // que é o mesmo papel do dist/404.html no GitHub Pages
    "not_found_handling": "single-page-application"
  }
}
